# Set a new, randomly generated token of at least 32 characters.
# Example generation: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AGENCY_ADMIN_TOKEN=
HOST=127.0.0.1
PORT=3000
AGENCY_DB_PATH=data/agency.sqlite
# Optional trusted browser origin. Set this to the external HTTPS origin behind
# a TLS-terminating proxy (for example, https://agency.example.com).
# HTTPS enables Secure session cookies; forwarding headers are never trusted.
# Without this setting, browser origins are limited to http://localhost:PORT,
# http://127.0.0.1:PORT, and http://[::1]:PORT for local development.
PUBLIC_ORIGIN=

# Optional: all three are required to enable sending a real Lark test message.
# Configuration is not proof of a successful connection.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_CHAT_ID=
